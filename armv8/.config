CONFIG_PACKAGE_ucode-mod-uclient=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
CONFIG_SDK=y
CONFIG_SDK_LLVM_BPF=y
CONFIG_TARGET_ROOTFS_PARTSIZE=300
CONFIG_VERSIONOPT=y
