# ---- luci base (ensure web UI) ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
# ---- custom packages (LYT T68M) ----
# ---- 运行期软件源修复: 关闭 feed 源开关 (仅影响固件内 distfeeds.list, 不影响包本身编译) ----
# diskman/video 的包已在官方 packages 源, 无需独立源; 避免固件自带 404 源导致 apk update 报错。
# store 源由 customfeeds.list 提供正确的 istoreos 源 (见 diy-part1.sh)。
# CONFIG_FEED_diskman is not set
# CONFIG_FEED_video is not set
# CONFIG_FEED_store is not set
# iStore store
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
# disk manager
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y
CONFIG_PACKAGE_lsblk=y
# argon theme & config (官方 luci feed: luci-theme-argon 2.4.3 + luci-app-argon-config)
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# sdio wifi (AIC8800) for daughterboard
CONFIG_PACKAGE_kmod-aic8800-sdio=y
CONFIG_PACKAGE_aic8800-sdio-firmware=y
# ---- SATA/mSATA (daughterboard): RK3568 DWC AHCI driver ----
# 实测根因: 此前只搞定设备树(sata2+combphy1 okay)但缺 ahci_dwc 驱动, mSATA 不被识别。
# kmod-ata-ahci-dwc 会自动拉取 kmod-ata-ahci-platform(+libahci/libata) + kmod-scsi-core 完整依赖链。
CONFIG_PACKAGE_kmod-ata-ahci-dwc=y
# ---- RTL8125 2.5G 网口 firmware (lan3/lan4) ----
# 实测根因: kmod-r8125 驱动已进(rootfs 有 r8125.ko) 但缺 rtl_nic/rtl8125*.fw, 网卡 probe 失败。
# r8169-firmware 提供 rtl_nic/rtl810* rtl812* rtl8168* rtl84*, 覆盖 rtl8125*.fw。
CONFIG_PACKAGE_r8169-firmware=y
# base fs tools for diskman
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_swap-utils=y
# ---- Docker (官方 luci-app-docker + Docker CE) ----
# luci-app-docker 的 LUCI_DEPENDS:=+luci-compat +docker +dockerd +e2fsprogs +fdisk 会自动拉取核心包:
#   docker(docker CLI)/dockerd(docker daemon)/containerd/runc 均在官方 packages feed (utils/docker 等)。
# 本 config 已有 CONFIG_ALL_KMODS=y，dockerd 需要的内核模块(br-netfilter/ipt-nat/veth 等)已全含。
CONFIG_PACKAGE_luci-app-docker=y
CONFIG_PACKAGE_luci-i18n-docker-zh-cn=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
# dockerd 运行时所需的用户态组件
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
